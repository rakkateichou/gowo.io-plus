[Unit]
Description=Gowo.io+ sync relay (wss://ru.rkde.su/gowo-plugin via Caddy)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /opt/gowo-plugin-relay/server.mjs
Environment=HOST=127.0.0.1 PORT=3000 NODE_ENV=production
DynamicUser=yes
# Chat history: /var/lib/gowo-plugin-relay/relay.sqlite
StateDirectory=gowo-plugin-relay
Restart=always
RestartSec=2
MemoryMax=160M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=yes

[Install]
WantedBy=multi-user.target
